@model IEnumerable<Cinema_Manager.ViewModels.Cinema.CinemaIndexViewModel>

@{
    ViewData["Title"] = "Кина";
}

<h1>Кина</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Добави кино</a>
</p>

@*Формата за търсене*@
<form asp-controller="Cinema" asp-action="Index" method="get" class="row g-3 mb-4">

    <div class="col-md-4">
        <label class="form-label">Име на кино</label>
        <input type="text"
               class="form-control"
               name="search"
               value="@ViewBag.Search"
               placeholder="Търсене по име..." />
    </div>

    <div class="col-md-2">
        <label class="form-label">Минимум зали</label>
        <input type="number"
               name="minHalls"
               value="@ViewBag.MinHalls"
               min="1"
               class="form-control" />
    </div>

    <div class="col-md-3">
        <label class="form-label">Сортиране</label>
        <select name="sortOrder" class="form-control">
            <option value="name" selected="@(ViewBag.SortOrder == "name")">
                Име А-Я
            </option>
            <option value="halls_asc" selected="@(ViewBag.SortOrder == "halls_asc")">
                Зали (възходящо)
            </option>
            <option value="halls_desc" selected="@(ViewBag.SortOrder == "halls_desc")">
                Зали (низходящо)
            </option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Търси</button>
        <a asp-action="Index" class="btn btn-secondary">Изчисти</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HallsCount)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ScreeningsCount)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.City)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.HallsCount)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ScreeningsCount)
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Редакция</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Детайли</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Изтриване</a>
                </td>
            </tr>
        }
    </tbody>
</table>
